; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be manually edited with care.

config_version=5

[application]

config/name="Wasteland Survivor"
config/description="Roguelike auto-shooter survival game"
config/version="0.1.0"
run/main_scene="res://src/scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://src/core/game_manager.gd"
SaveManager="*res://src/core/save_manager.gd"
AudioManager="*res://src/core/audio_manager.gd"
VfxManager="*res://src/core/vfx_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

